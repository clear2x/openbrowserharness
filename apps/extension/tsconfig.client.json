{
  "extends": "../../tsconfig.base.client.json",
  "compilerOptions": {
    // The fixture twin (packages/client/connection/src/client/fixture.ts —
    // upstream deleted it, the fork's panel fixture lane keeps it) is pulled
    // in from outside this package, so the common root is the repo root.
    "rootDir": "../..",
    "outDir": "lib/types-client",
    "types": [
      "chrome",
      "node"
    ],
    // The base client typeRoots point at the repo root only; @types/chrome is
    // linked into this package's own node_modules, so re-include it here.
    "typeRoots": [
      "./node_modules/@types",
      "../../scripts/types",
      "../../node_modules/@types"
    ],
    // Same extensionful-import rationale as the host face next door.
    "emitDeclarationOnly": true,
    "rewriteRelativeImportExtensions": false
  },
  "include": [
    "src/sidepanel",
    "src/sidepanel-dsh",
    "src/shared",
    "src/shims",
    "../../packages/client/connection/src/client/fixture.ts",
    "tests/sidepanel-boot.spec.ts",
    "tests/capability-occupied.spec.ts",
    "tests/caps-css.spec.ts",
    "tests/composer-bar.spec.tsx",
    "tests/interaction-cards.spec.tsx",
    "tests/user-plugin-panel.spec.tsx",
    "tests/trajectory-host.spec.tsx"
  ],
  "references": [
    {
      "path": "../../packages/browser/browser"
    },
    {
      "path": "../../packages/client/modules"
    },
    {
      "path": "../../packages/client/ui-settings-models"
    },
    {
      "path": "../../packages/client/ui-layout"
    },
    {
      "path": "../../packages/client/ui-sidebar"
    },
    {
      "path": "../../packages/client/ui-theme/tsconfig.client.json"
    },

    {
      "path": "../../packages/client/web"
    },
    {
      "path": "../../packages/client/ui-trajectory/tsconfig.client.json"
    },
    {
      "path": "../../packages/client/connection/tsconfig.client.json"
    },
    {
      "path": "../../packages/host/apiproxy"
    }
  ]
}
