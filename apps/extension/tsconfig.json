{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "lib/types",
    "lib": [
      "ES2024",
      "DOM",
      "DOM.Iterable",
      "WebWorker"
    ],
    "types": [
      "chrome",
      "node"
    ],
    // Workspace-internal modules are imported extensionful (`.ts`) so
    // vite/vitest resolve SOURCE files — the packages' source dirs once
    // carried stale tsc `.js` twins that won any extensionless lookup.
    // Declarations are all this project emits (the shipped artifact is the
    // vite bundle built from source) and are consumed by nothing.
    "emitDeclarationOnly": true,
    "rewriteRelativeImportExtensions": false
  },
  "include": [
    "src/offscreen",
    "src/background",
    "src/chrome",
    "src/sandbox",
    "src/shared",
    "src/shims",
    "tests"
  ],
  "exclude": [
    // Client-face specs (the client face carries jsx + the client graph).
    "tests/sidepanel-boot.spec.ts",
    "tests/capability-occupied.spec.ts",
    "tests/caps-css.spec.ts",
    "tests/composer-bar.spec.tsx",
    "tests/composer-attachments.spec.tsx",
    "tests/interaction-cards.spec.tsx",
    "tests/user-plugin-panel.spec.tsx",
    "tests/trajectory-host.spec.tsx"
  ],
