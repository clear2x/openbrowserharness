{
  "manifest_version": 3,
  "name": "OpenBrowserHarness",
  "version": "0.7.0",
  "description": "An AI agent in your browser: it navigates real pages, fills forms, and extracts content \u2014 visible actions, under your approval.",
  "minimum_chrome_version": "134",
  "permissions": [
    "offscreen",
    "debugger",
    "sidePanel",
    "storage",
    "tabs",
    "activeTab",
    "alarms",
    "sessions",
    "notifications",
    "declarativeNetRequest",
    "contextMenus",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": ["oauth-relay.html"],
      "matches": ["https://platform.deepseek.com/*", "http://127.0.0.1/*"]
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "sandbox": {
    "pages": [
      "sandbox.html"
    ]
  },
  "action": {
    "default_title": "\u6253\u5f00 OpenBrowserHarness \u9762\u677f",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
