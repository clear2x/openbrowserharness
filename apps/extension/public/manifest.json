{
  "manifest_version": 3,
  "name": "OpenBrowserHarness",
  "version": "0.8.3",
  "default_locale": "en",
  "description": "__MSG_extDescription__",
  "minimum_chrome_version": "134",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "permissions": [
    "offscreen",
    "debugger",
    "sidePanel",
    "storage",
    "tabs",
    "activeTab",
    "alarms",
    "sessions",
    "notifications",
    "declarativeNetRequest",
    "contextMenus",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": ["oauth-relay.html"],
      "matches": ["https://platform.deepseek.com/*", "http://127.0.0.1/*"]
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "sandbox": {
    "pages": [
      "sandbox.html"
    ]
  },
  "action": {
    "default_title": "__MSG_extTitle__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
