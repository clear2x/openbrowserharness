{
  "manifest_version": 3,
  "name": "OpenBrowserHarness",
  "version": "0.2.1",
  "description": "An AI agent that lives in your browser: it navigates real pages, fills forms, and extracts content — humanized input, visible actions, under your approval.",
  "minimum_chrome_version": "134",
  "permissions": [
    "offscreen",
    "debugger",
    "sidePanel",
    "storage",
    "tabs",
    "activeTab",
    "alarms",
    "sessions"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "sandbox": {
    "pages": [
      "sandbox.html"
    ]
  },
  "action": {
    "default_title": "打开 OpenBrowserHarness 面板",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
